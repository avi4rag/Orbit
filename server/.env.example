# ──────────────────────────────────────────────────────────────────
# ORBIT Backend (server/) — Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this to server/.env for local development.
# For production deployment add these to your hosting provider's
# environment settings (Railway, Render, Fly.io, etc.).
# ──────────────────────────────────────────────────────────────────

# Server port (default: 4000)
PORT=4000

# ──────────────────────────────────────────────────────────────────
# REQUIRED — Database
# ──────────────────────────────────────────────────────────────────

# MongoDB connection string.
# Local: mongodb://localhost:27017/orbit
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/orbit
MONGODB_URI=

# ──────────────────────────────────────────────────────────────────
# REQUIRED — Auth
# ──────────────────────────────────────────────────────────────────

# Secret used to sign JWT tokens. Use a long random string in production.
JWT_SECRET=

# ──────────────────────────────────────────────────────────────────
# REQUIRED — AI (Gemini)
# ──────────────────────────────────────────────────────────────────

# Google Gemini API key for script generation.
GEMINI_API_KEY=

# ──────────────────────────────────────────────────────────────────
# REQUIRED — Text-to-Speech
# ──────────────────────────────────────────────────────────────────

# ElevenLabs API key (primary TTS provider)
ELEVENLABS_API_KEY=

# Azure Cognitive Speech (secondary / fallback TTS provider)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Default TTS provider: elevenlabs | azure
TTS_PROVIDER=elevenlabs

# ──────────────────────────────────────────────────────────────────
# OPTIONAL — YouTube Data API (subliminal catalog ingestion)
# ──────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=

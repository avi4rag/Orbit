# ──────────────────────────────────────────────────────────────────
# ORBIT Frontend — Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development.
# For production, add these to Vercel → Project Settings → Environment Variables.
#
# ──────────────────────────────────────────────────────────────────
# REQUIRED FOR PRODUCTION
# ──────────────────────────────────────────────────────────────────

# The URL of your deployed Express backend (no trailing slash).
# Example: https://orbit-api.onrender.com
# In local development this is NOT needed — Vite proxies /api → localhost:4000.
#
# USER ACTION REQUIRED (production):
#   Deploy server/ to Railway, Render, Fly.io, or similar.
#   Then set this variable in Vercel → Production environment.
#
VITE_API_URL=

# ──────────────────────────────────────────────────────────────────
# OPTIONAL / LOCAL ONLY
# ──────────────────────────────────────────────────────────────────

# Leave empty locally — Vite's proxy (vite.config.ts) handles /api.
# VITE_API_URL=http://localhost:4000
